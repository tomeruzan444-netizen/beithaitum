# בית האיטום - אתר סטטי (Astro)
DirectoryIndex index.html
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  # חסימת גישה לתיקיית .git (הוסטינגר מושך את ענף live ב-git)
  RewriteRule (^|/)\.git(/|$) - [F,L]
  # הדומיין הזמני של הוסטינגר -> הדומיין הראשי (301)
  RewriteCond %{HTTP_HOST} hostingersite\.com$ [NC]
  RewriteRule ^ https://itumhouse.co.il%{REQUEST_URI} [L,R=301]
  # HTTPS בלבד
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # הסרת www (כתובת canonical אחת)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # אותיות גדולות בנתיב -> 404 טבעי; סלאש בסוף מטופל ע"י mod_dir (301 לתיקייה)
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|avif|png|jpg|jpeg|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS
  # האתר חסום לגוגל עד אישור המשתמש (כל הדומיינים). לפתיחה: למחוק את השורה + blockIndexing: false ב-business.ts
  Header always set X-Robots-Tag "noindex, nofollow"

</IfModule>

AddDefaultCharset UTF-8
