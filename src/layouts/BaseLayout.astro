---
import '@fontsource/ibm-plex-sans-hebrew/400.css';
import '@fontsource/ibm-plex-sans-hebrew/600.css';
import '@fontsource/frank-ruhl-libre/700.css';
import '../styles/global.css';
import plexHe400 from '@fontsource/ibm-plex-sans-hebrew/files/ibm-plex-sans-hebrew-hebrew-400-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import { business, isFilled, isTemporaryDomain } from '../config/business';

interface Props {
  title: string;
  description: string;
  /** JSON-LD נוסף לעמוד (מערך אובייקטים) */
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const robots = noindex || isTemporaryDomain() ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const siteUrl = new URL('/', Astro.site).href;

const sameAs = [business.googleBusiness, ...business.social].filter(isFilled);
const org: Record<string, unknown> = {
  '@type': 'Organization',
  '@id': `${siteUrl}#org`,
  name: business.name,
  alternateName: business.nameEn,
  url: siteUrl,
  logo: new URL('/favicon.svg', Astro.site).href,
  ...(isFilled(business.phone) && { telephone: business.phone }),
  ...(isFilled(business.email) && { email: business.email }),
  ...(sameAs.length && { sameAs }),
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [
    org,
    { '@type': 'WebSite', '@id': `${siteUrl}#website`, url: siteUrl, name: business.name, inLanguage: 'he-IL', publisher: { '@id': `${siteUrl}#org` } },
    ...schema,
  ],
};
---
<!doctype html>
<html lang="he" dir="rtl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={robots} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="preload" href={plexHe400} as="font" type="font/woff2" crossorigin />
  <meta name="theme-color" content="#1B2226" />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="he_IL" />
  <meta property="og:site_name" content={business.name} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <script type="application/ld+json" set:html={JSON.stringify(graph)} />
</head>
<body>
  <a class="skip" href="#main">דילוג לתוכן</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <MobileBar />
</body>
</html>
