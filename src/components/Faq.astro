---
interface Props { items: { q: string; a: string }[]; heading?: string }
const { items, heading = 'שאלות נפוצות' } = Astro.props;
---
{items.length > 0 && (
  <section class="faq-sec" aria-labelledby="faq-h">
    <h2 id="faq-h">{heading}</h2>
    <div class="faq">
      {items.map((f) => <details><summary>{f.q}</summary><div><p>{f.a}</p></div></details>)}
    </div>
  </section>
)}
<style>
  .faq-sec { margin-block: 3rem; }
</style>
