---
// אייקונים איזומטריים מפורטים (כרטיסים, סיידבר). הגיאומטריה ב-src/lib/isoIcons.ts.
import { isoShapes, ISO_VIEW } from '../lib/isoIcons';
import type { IsoName as N } from '../lib/isoIcons';
export type IsoName = N;
interface Props { name: IsoName; size?: number }
const { name, size = 44 } = Astro.props;
const shapes = isoShapes(name);
---
<svg viewBox={ISO_VIEW.vb} width={size} height={Math.round(size * ISO_VIEW.ratio)} aria-hidden="true" class="iso" stroke-linejoin="round">
  {shapes.map((s) => (
    <path d={s.d} fill={s.fill ?? 'none'} stroke={s.stroke} stroke-width={s.sw} opacity={s.op} stroke-linecap={s.cap} stroke-dasharray={s.dash} />
  ))}
</svg>
