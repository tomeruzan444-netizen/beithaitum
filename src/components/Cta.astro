---
import Icon from './Icon.astro';
import { telHref, waHref } from '../config/business';
interface Props { title: string; text: string; wa?: string }
const { title, text, wa } = Astro.props;
---
<aside class="cta" aria-label="פנייה לצוות">
  <div>
    <p class="t">{title}</p>
    <p class="x">{text}</p>
  </div>
  <div class="b">
    <a class="btn btn--peach" href={waHref(wa)}><Icon name="chat" />שליחה בוואטסאפ</a>
    <a class="btn btn--light" href={telHref()}><Icon name="phone" />שיחה</a>
  </div>
</aside>
<style>
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem; background: var(--ink); color: var(--on-dark); padding: 1.5rem 1.6rem; margin-block: 2.8rem; }
  .t { font: 800 1.35rem/1.25 var(--f); margin: 0 0 .25rem; }
  .x { margin: 0; color: var(--on-dark-2); font-size: 1rem; max-width: 50ch; }
  .b { display: flex; flex-wrap: wrap; gap: .6rem; }
</style>
