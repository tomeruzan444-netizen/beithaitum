---
import Icon from './Icon.astro';
import { telHref, waHref } from '../config/business';
interface Props { title: string; text: string; wa?: string }
const { title, text, wa } = Astro.props;
---
<aside class="cta" aria-label="פנייה לצוות">
  <div>
    <p class="t">{title}</p>
    <p class="x">{text}</p>
  </div>
  <div class="b">
    <a class="btn btn--primary" href={telHref()}><Icon name="phone" />שיחה עם הצוות</a>
    <a class="btn btn--light" href={waHref(wa)}><Icon name="chat" />וואטסאפ</a>
  </div>
</aside>
<style>
  .cta { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.2rem; background: var(--concrete); color: var(--on-dark); padding: 1.5rem 1.6rem; margin-block: 2.5rem; border-inline-start: 6px solid var(--copper); }
  .t { font: 700 1.3rem/1.3 var(--f-head); margin: 0 0 .3rem; }
  .x { margin: 0; color: var(--on-dark-2); font-size: 1rem; max-width: 52ch; }
  .b { display: flex; flex-wrap: wrap; gap: .6rem; }
</style>
