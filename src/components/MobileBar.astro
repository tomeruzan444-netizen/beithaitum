---
// פס תחתון קבוע בנייד: חיוג, וואטסאפ, הצעת מחיר. HTML+CSS בלבד.
import Icon from './Icon.astro';
import { telHref, waHref } from '../config/business';
---
<nav class="mbar" aria-label="פנייה מהירה">
  <a href={telHref()}><Icon name="phone" /><span>חיוג</span></a>
  <a href={waHref()}><Icon name="chat" /><span>וואטסאפ</span></a>
  <a href="/#contact" class="hl"><Icon name="doc" /><span>הצעת מחיר</span></a>
</nav>
<style>
  .mbar { display: none; }
  @media (max-width: 640px) {
    .mbar { display: grid; grid-template-columns: 1fr 1fr 1.2fr; position: fixed; inset-inline: 0; bottom: 0; z-index: 60; background: var(--ink); border-block-start: 3px solid var(--copper); padding-bottom: env(safe-area-inset-bottom); }
    .mbar a { display: flex; flex-direction: column; align-items: center; gap: 2px; padding: .55rem 0 .5rem; color: var(--on-dark); text-decoration: none; font-size: .82rem; font-weight: 600; }
    .mbar a + a { border-inline-start: 1px solid rgba(237,233,224,.12); }
    .mbar :global(svg) { width: 22px; height: 22px; }
    .mbar .hl { background: var(--copper); color: #fff; }
    :global(body) { padding-bottom: 64px; }
  }
</style>
