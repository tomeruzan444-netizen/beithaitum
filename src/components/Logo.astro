---
// סימן: גג מעל שלוש שכבות (תשתית, איטום בנחושת, הגנה)
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const fg = dark ? '#EDE9E0' : '#1B2226';
---
<a href="/" class="logo" aria-label="בית האיטום - לדף הבית">
  <svg viewBox="0 0 40 40" width="40" height="40" aria-hidden="true">
    <path d="M6 17 20 6l14 11" fill="none" stroke={fg} stroke-width="2.6" stroke-linejoin="round" stroke-linecap="square"/>
    <rect x="7" y="21" width="26" height="3.4" fill="#B0562B"/>
    <rect x="7" y="26.4" width="26" height="2.8" fill={fg} opacity=".8"/>
    <rect x="7" y="31.2" width="26" height="2.6" fill={fg} opacity=".45"/>
  </svg>
  <span style={`color:${fg}`}>בית האיטום</span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; }
  .logo span { font: 700 1.45rem/1 var(--f-head); letter-spacing: -.01em; }
</style>
