---
// סימן: קופסה איזומטרית בשכבות. טקסט: בית האיטום + "שכבה אחרי שכבה".
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const fg = dark ? '#F2F0EA' : '#15181D';
---
<a href="/" class="logo" aria-label="בית האיטום - לדף הבית">
  <svg viewBox="0 0 44 36" width="42" height="34" aria-hidden="true">
    <polygon points="22,2 42,12 22,22 2,12" fill="#ECE8DF" stroke={fg} stroke-width="1.2" />
    <polygon points="2,12 22,22 22,26 2,16" fill="#23272E" />
    <polygon points="22,22 42,12 42,16 22,26" fill="#15181D" />
    <polygon points="2,16 22,26 22,29 2,19" fill="#A65A2E" />
    <polygon points="22,26 42,16 42,19 22,29" fill="#8F4B24" />
    <polygon points="2,19 22,29 22,34 2,24" fill="#BDB5A6" />
    <polygon points="22,29 42,19 42,24 22,34" fill="#A39A8A" />
  </svg>
  <span class="t">
    <span class="n" style={`color:${fg}`}>בית האיטום</span>
    <span class="s" style={`color:${dark ? '#A9ADB3' : '#7A8088'}`}>שכבה אחרי שכבה</span>
  </span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: .6rem; text-decoration: none; }
  .t { display: flex; flex-direction: column; line-height: 1; }
  .n { font: 800 1.45rem/1 var(--f); letter-spacing: -.02em; }
  .s { font: 500 .72rem/1 var(--f); margin-top: .3rem; letter-spacing: .04em; }
</style>
