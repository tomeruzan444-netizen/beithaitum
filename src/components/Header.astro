---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business, isFilled, telHref } from '../config/business';
import { menu, urlOf, publishedSet } from '../lib/pages';
const groups = (await menu()).filter((g) => g.silo.id !== 'areas');
const pub = await publishedSet();
const path = Astro.url.pathname;
const seg = path.split('/')[1] ?? '';
const isTarring = path.startsWith('/roof-waterproofing/roof-tarring/');
const nav = [
  { href: '/roof-waterproofing/', label: 'איטום גגות', on: seg === 'roof-waterproofing' && !isTarring },
  { href: '/roof-waterproofing/roof-tarring/', label: 'זיפות גגות', on: isTarring },
  { href: '/#process', label: 'תהליך', on: false },
  { href: '/moisture/', label: 'רטיבות ונזילות', on: seg === 'moisture' },
  { href: '/prices/', label: 'מחירון', on: seg === 'prices' },
].filter((n) => n.href.startsWith('/#') || pub.has(n.href));
// 15 הערים המאוכלסות בישראל (סדר לפי גודל) - מוצגות רק אם לעמוד העיר יש תוכן מפורסם
const topCities = [
  ['jerusalem', 'ירושלים'], ['tel-aviv', 'תל אביב'], ['haifa', 'חיפה'], ['rishon-lezion', 'ראשון לציון'],
  ['petah-tikva', 'פתח תקווה'], ['ashdod', 'אשדוד'], ['netanya', 'נתניה'], ['beer-sheva', 'באר שבע'],
  ['bnei-brak', 'בני ברק'], ['holon', 'חולון'], ['ramat-gan', 'רמת גן'], ['beit-shemesh', 'בית שמש'],
  ['rehovot', 'רחובות'], ['ashkelon', 'אשקלון'], ['bat-yam', 'בת ים'],
].map(([slug, label]) => ({ href: `/areas/${slug}/`, label })).filter((c) => pub.has(c.href));
const areasOn = seg === 'areas';
const servicesOn = groups.some((g) => g.silo.id === seg && seg !== 'moisture' && seg !== 'roof-waterproofing');
---
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav class="desk" aria-label="ניווט ראשי">
      <ul class="top">
        {groups.length > 0 && (
          <li class="mega">
            <a href={urlOf(groups[0].hub)} class:list={[{ on: servicesOn }]} aria-haspopup="true">שירותים <span class="car" aria-hidden="true"></span></a>
            <div class="panel">
              <div class="wrap cols">
                {groups.map((g) => (
                  <div class="col">
                    <a class="ch" href={urlOf(g.hub)}>{g.silo.name}</a>
                    <ul>{g.items.slice(0, 6).map((i) => <li><a href={urlOf(i)}>{i.data.keyword}</a></li>)}</ul>
                    {g.total > 6 && <a class="all" href={urlOf(g.hub)}>לכל {g.total} הנושאים ←</a>}
                  </div>
                ))}
              </div>
            </div>
          </li>
        )}
        {nav.slice(0, 2).map((n) => <li><a href={n.href} class:list={[{ on: n.on }]}>{n.label}</a></li>)}
        {pub.has('/areas/') && (
          <li class="mega">
            <a href="/areas/" class:list={[{ on: areasOn }]} aria-haspopup="true">אזורי שירות <span class="car" aria-hidden="true"></span></a>
            <div class="panel">
              <div class="wrap">
                <ul class="cities">{topCities.map((c) => <li><a href={c.href}>איטום גגות ב{c.label}</a></li>)}</ul>
                <a class="all" href="/areas/">לכל אזורי השירות ←</a>
              </div>
            </div>
          </li>
        )}
        {nav.slice(2).map((n) => <li><a href={n.href} class:list={[{ on: n.on }]}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="srch-btn" href="/search/" aria-label="חיפוש באתר"><Icon name="search" /></a>
      <a class="call" href={telHref()}>{isFilled(business.phone) ? <span dir="ltr">{business.phone}</span> : <span class="ph">[מספר טלפון]</span>}</a>
      <a class="btn btn--dark quote" href="/contact/">בדיקת גג</a>
      <details class="mob">
        <summary aria-label="תפריט"><Icon name="menu" /></summary>
        <nav class="drawer" aria-label="ניווט ראשי בנייד">
          {groups.map((g) => (
            <details>
              <summary>{g.silo.name}</summary>
              <ul>
                <li><a href={urlOf(g.hub)}>{g.hub.data.keyword} - סקירה</a></li>
                {g.items.map((i) => <li><a href={urlOf(i)}>{i.data.keyword}</a></li>)}
              </ul>
            </details>
          ))}
          {pub.has('/areas/') && (
            <details>
              <summary>אזורי שירות</summary>
              <ul>
                {topCities.map((c) => <li><a href={c.href}>איטום גגות ב{c.label}</a></li>)}
                <li><a href="/areas/">כל אזורי השירות</a></li>
              </ul>
            </details>
          )}
          <ul class="flat">{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/contact/">צור קשר</a></li></ul>
        </nav>
      </details>
    </div>
  </div>
</header>
<style>
  .site-header { background: var(--mist); position: sticky; top: 0; z-index: 50; border-bottom: 1px solid var(--line-2); }
  .bar { display: flex; align-items: center; gap: 2rem; min-height: 76px; }
  .desk { margin-inline-start: 1rem; }
  .top { display: flex; gap: 1.6rem; list-style: none; margin: 0; padding: 0; }
  .top > li > a { position: relative; color: var(--ink); text-decoration: none; font-size: 1rem; font-weight: 600; padding-block: 1.7rem; display: inline-flex; align-items: center; gap: .35rem; }
  .top > li > a:hover, .top > li > a.on { color: var(--copper); }
  .top > li > a.on::after { content: ''; position: absolute; inset-inline: 0; bottom: 0; height: 2px; background: var(--copper); }
  .car { width: 6px; height: 6px; border-inline-end: 1.5px solid currentColor; border-block-end: 1.5px solid currentColor; transform: rotate(45deg) translateY(-2px); }
  .panel { position: absolute; inset-inline: 0; top: 100%; background: var(--paper); border-block: 1px solid var(--line); box-shadow: 0 18px 36px rgba(21,24,29,.1); visibility: hidden; opacity: 0; transition: opacity .12s; }
  .mega:hover .panel, .mega:focus-within .panel { visibility: visible; opacity: 1; }
  .cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.8rem 2.2rem; padding-block: 2rem 2.2rem; }
  .ch { display: block; font: 800 1.05rem/1.3 var(--f); color: var(--ink); text-decoration: none; padding-bottom: .55rem; margin-bottom: .4rem; border-bottom: 2px solid var(--ink); }
  .col ul { list-style: none; margin: 0; padding: 0; }
  .col li a { display: block; padding: .28rem 0; font-size: .95rem; color: var(--ink-2); text-decoration: none; }
  .col li a:hover, .ch:hover { color: var(--copper); }
  .cities { list-style: none; margin: 0; padding: 2rem 0 .6rem; display: grid; grid-template-columns: repeat(5, 1fr); gap: .2rem 2rem; }
  .cities a { display: block; padding: .3rem 0; font-size: .95rem; color: var(--ink-2); text-decoration: none; }
  .cities a:hover { color: var(--copper); }
  .panel .all { margin-bottom: 1.8rem; }
  .all { display: inline-block; margin-top: .4rem; font-size: .88rem; font-weight: 700; color: var(--copper-ink); text-decoration: none; }
  .actions { display: flex; align-items: center; gap: .9rem; margin-inline-start: auto; }
  .srch-btn { display: grid; place-items: center; width: 38px; height: 38px; color: var(--ink); }
  .srch-btn :global(svg) { width: 21px; height: 21px; }
  .call { color: var(--ink); text-decoration: none; font-weight: 600; font-size: .95rem; border-bottom: 1px solid var(--ink); padding-bottom: 2px; }
  .call .ph { border: 0; padding: 0; }
  .quote { min-height: 42px; padding-block: .5em; padding-inline: 1.3em; }
  .mob { display: none; }
  .mob > summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-items: center; border: 1.5px solid var(--ink); border-radius: var(--r); }
  .mob summary::-webkit-details-marker { display: none; }
  .mob > summary :global(svg) { width: 22px; }
  .drawer { position: absolute; inset-inline: 0; top: 100%; max-height: calc(100vh - 76px); overflow-y: auto; background: var(--paper); border-top: 1px solid var(--line); box-shadow: 0 14px 30px rgba(21,24,29,.14); padding: .5rem var(--gutter) 1.5rem; }
  .drawer details { border-bottom: 1px solid var(--line); }
  .drawer details summary { cursor: pointer; list-style: none; padding: .9rem 0; font: 800 1.08rem/1.3 var(--f); }
  .drawer ul { list-style: none; margin: 0; padding: 0 0 .8rem; }
  .drawer li a { display: block; padding: .5rem .2rem; color: var(--ink); text-decoration: none; }
  .drawer .flat { padding-top: .6rem; }
  .drawer .flat a { font-weight: 700; }
  @media (max-width: 1100px) { .desk { display: none; } .mob { display: block; } }
  @media (max-width: 640px) { .call, .quote, .srch-btn { display: none; } .bar { min-height: 64px; } }
</style>
