---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { business, isFilled, telHref } from '../config/business';
import { menu, urlOf, publishedSet } from '../lib/pages';
// מגה-מניו נבנה מה-Hubs המפורסמים. כל עוד אין Hubs - ניווט לאזורי דף הבית.
const groups = await menu();
const pub = await publishedSet();
const extra = [
  { href: '/moisture/', label: 'רטיבות ונזילות' },
  { href: '/prices/', label: 'מחירון' },
  { href: '/areas/', label: 'אזורי שירות' },
].filter((x) => pub.has(x.href));
const fallback = [
  { href: '/#problems', label: 'לפי בעיה' },
  { href: '/#roofs', label: 'סוגי גגות' },
  { href: '/#methods', label: 'שיטות איטום' },
  { href: '/#process', label: 'איך אנחנו עובדים' },
  { href: '/#faq', label: 'שאלות נפוצות' },
];
const flat = groups.length ? extra : fallback;
---
<header class="site-header">
  <div class="wrap bar">
    <Logo />
    <nav class="desk" aria-label="ניווט ראשי">
      <ul class="top">
        {groups.length > 0 && (
          <li class="mega">
            <a href={urlOf(groups[0].hub)} aria-haspopup="true">שירותי איטום <span class="car" aria-hidden="true"></span></a>
            <div class="panel">
              <div class="wrap cols">
                {groups.map((g) => (
                  <div class="col">
                    <a class="ch" href={urlOf(g.hub)}>{g.silo.name}</a>
                    <ul>{g.items.slice(0, 6).map((i) => <li><a href={urlOf(i)}>{i.data.keyword}</a></li>)}</ul>
                    {g.total > 6 && <a class="all" href={urlOf(g.hub)}>לכל {g.total} הנושאים</a>}
                  </div>
                ))}
              </div>
            </div>
          </li>
        )}
        {flat.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <div class="actions">
      <a class="call" href={telHref()}>
        <Icon name="phone" />
        {isFilled(business.phone) ? <span dir="ltr">{business.phone}</span> : <span>חיוג</span>}
      </a>
      <a class="btn btn--primary quote" href="/#contact">לקבלת הצעת מחיר</a>
      <details class="mob">
        <summary aria-label="תפריט"><Icon name="menu" /></summary>
        <nav class="drawer" aria-label="ניווט ראשי בנייד">
          {groups.map((g) => (
            <details>
              <summary>{g.silo.name}</summary>
              <ul>
                <li><a href={urlOf(g.hub)}>{g.hub.data.keyword} - סקירה</a></li>
                {g.items.map((i) => <li><a href={urlOf(i)}>{i.data.keyword}</a></li>)}
              </ul>
            </details>
          ))}
          <ul class="flat">{flat.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
        </nav>
      </details>
    </div>
  </div>
  <div class="layers-sep" aria-hidden="true"><span></span><span></span><span></span></div>
</header>
<style>
  .site-header { background: var(--stone); position: sticky; top: 0; z-index: 50; }
  .bar { display: flex; align-items: center; gap: 1.5rem; min-height: 72px; }
  .desk { margin-inline-start: auto; }
  .top { display: flex; gap: 1.4rem; list-style: none; margin: 0; padding: 0; }
  .top > li > a { color: var(--bitumen); text-decoration: none; font-size: .98rem; font-weight: 600; padding-block: 1.5rem; border-block-end: 1.5px solid transparent; display: inline-flex; align-items: center; gap: .35rem; }
  .top > li > a:hover { color: var(--copper-ink); }
  .car { width: 7px; height: 7px; border-inline-end: 1.5px solid currentColor; border-block-end: 1.5px solid currentColor; transform: rotate(45deg) translateY(-2px); }
  .panel { position: absolute; inset-inline: 0; top: 100%; background: var(--stone); border-block: 1px solid var(--line); box-shadow: 0 14px 30px rgba(27,34,38,.1); visibility: hidden; opacity: 0; transition: opacity .12s; }
  .mega:hover .panel, .mega:focus-within .panel { visibility: visible; opacity: 1; }
  .cols { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 1.6rem 2rem; padding-block: 1.8rem 2rem; }
  .ch { display: block; font: 700 1.05rem/1.3 var(--f-head); color: var(--bitumen); text-decoration: none; padding-bottom: .5rem; margin-bottom: .4rem; border-bottom: 2px solid var(--copper); }
  .col ul { list-style: none; margin: 0; padding: 0; }
  .col li a { display: block; padding: .28rem 0; font-size: .93rem; color: var(--ink-2); text-decoration: none; }
  .col li a:hover, .ch:hover { color: var(--copper-ink); }
  .all { display: inline-block; margin-top: .4rem; font-size: .88rem; font-weight: 600; }
  .actions { display: flex; align-items: center; gap: .8rem; }
  .call { display: inline-flex; align-items: center; gap: .4rem; color: var(--bitumen); text-decoration: none; font-weight: 600; font-size: 1rem; }
  .call :global(svg) { width: 1.2rem; height: 1.2rem; color: var(--copper); }
  .quote { min-height: 42px; padding-block: .5em; font-size: .95rem; }
  .mob { display: none; }
  .mob > summary { list-style: none; cursor: pointer; width: 44px; height: 44px; display: grid; place-items: center; border: 1.5px solid var(--bitumen); border-radius: var(--r); }
  .mob summary::-webkit-details-marker { display: none; }
  .mob > summary :global(svg) { width: 22px; }
  .drawer { position: absolute; inset-inline: 0; top: 100%; max-height: calc(100vh - 70px); overflow-y: auto; background: var(--stone); border-top: 1px solid var(--line); box-shadow: 0 14px 30px rgba(27,34,38,.14); padding: .5rem var(--gutter) 1.5rem; }
  .drawer details { border-bottom: 1px solid var(--line); }
  .drawer details summary { cursor: pointer; list-style: none; padding: .9rem 0; font: 700 1.08rem/1.3 var(--f-head); }
  .drawer ul { list-style: none; margin: 0; padding: 0 0 .8rem; }
  .drawer li a { display: block; padding: .5rem .2rem; color: var(--bitumen); text-decoration: none; }
  .drawer .flat { padding-top: .6rem; }
  .drawer .flat a { font-weight: 600; }
  @media (max-width: 1080px) { .desk { display: none; } .actions { margin-inline-start: auto; } .mob { display: block; } }
  @media (max-width: 640px) { .call, .quote { display: none; } .bar { min-height: 62px; } }
</style>
