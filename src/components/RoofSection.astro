---
// חתך גג בטון שטוח - האלמנט החתימתי של האתר. מספרים בשרטוט, מקרא כטקסט HTML נגיש.
interface Props { caption?: string }
const { caption = 'חתך גג בטון שטוח: שכבות מערכת האיטום' } = Astro.props;
const legend = [
  'תקרת בטון - התשתית הקונסטרוקטיבית',
  'בטון שיפועים - מוביל את המים לניקוז',
  'רולקה - מעגלת את הפינה בין הגג למעקה',
  'פריימר - שכבת הקשר בין התשתית לאיטום',
  'שכבת האיטום - יריעה או חומר מריחה',
  'הגבהת האיטום על המעקה',
  'שכבת הגנה וציפוי מחזיר קרינה',
];
// [מספר, x של העיגול, y של העיגול, x יעד, y יעד]
const marks: [number, number, number, number, number][] = [
  [6, 150, 44, 97, 140],
  [3, 215, 44, 99, 191],
  [7, 300, 44, 300, 198],
  [5, 380, 44, 380, 207],
  [4, 460, 44, 460, 215],
  [2, 540, 44, 540, 230],
  [1, 480, 330, 480, 268],
];
---
<figure class="section-fig">
  <svg viewBox="0 0 640 352" role="img" aria-labelledby="rs-t">
    <title id="rs-t">{caption}</title>
    <defs>
      <pattern id="hatch" width="9" height="9" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="9" stroke="#1B2226" stroke-opacity=".22" stroke-width="1" />
      </pattern>
      <pattern id="aggr" width="14" height="10" patternUnits="userSpaceOnUse">
        <circle cx="3" cy="3" r="1" fill="#1B2226" fill-opacity=".25" />
        <circle cx="10" cy="7" r=".8" fill="#1B2226" fill-opacity=".2" />
      </pattern>
    </defs>

    <!-- קווי מידה עדינים -->
    <g stroke="#1B2226" stroke-opacity=".12">
      <line x1="20" y1="300" x2="630" y2="300" />
      <line x1="20" y1="62" x2="20" y2="300" stroke-dasharray="3 4" />
    </g>

    <!-- מעקה ותקרה -->
    <rect x="40" y="72" width="50" height="220" fill="#DCD6CB" />
    <rect x="40" y="72" width="50" height="220" fill="url(#hatch)" />
    <rect x="90" y="240" width="530" height="52" fill="#D2CCC0" />
    <rect x="90" y="240" width="530" height="52" fill="url(#hatch)" />
    <rect x="90" y="240" width="530" height="52" fill="url(#aggr)" />
    <!-- קופינג -->
    <rect x="32" y="62" width="66" height="10" fill="#2A3136" />

    <!-- בטון שיפועים -->
    <polygon points="90,240 620,240 620,223.9 90,200" fill="#E6E0D4" />
    <polygon points="90,240 620,240 620,223.9 90,200" fill="url(#aggr)" />
    <!-- רולקה -->
    <path d="M90 200 L90 174 Q91 199 116 201.2 Z" fill="#C9C1B2" />

    <!-- פריימר / איטום / הגנה -->
    <path d="M91.5 110 L91.5 174 Q92.5 197.5 116 199.7 L620 222.4" fill="none" stroke="#6B5A4A" stroke-width="2" stroke-dasharray="5 3" />
    <path d="M96 112 L96 172 Q97 193 116 195.2 L620 217.9" fill="none" stroke="#B0562B" stroke-width="7" />
    <path d="M101.5 114 L101.5 170 Q102.5 188 116 189.7 L620 212.4" fill="none" stroke="#F3F0E9" stroke-width="3.2" />
    <path d="M101.5 114 L101.5 170 Q102.5 188 116 189.7 L620 212.4" fill="none" stroke="#1B2226" stroke-opacity=".35" stroke-width=".8" transform="translate(0 -1.8)" />
    <!-- פס הידוק -->
    <rect x="89" y="106" width="16" height="6" fill="#2A3136" />

    <!-- חץ שיפוע -->
    <g stroke="#1B2226" stroke-width="1.2" fill="none">
      <line x1="140" y1="318" x2="400" y2="318" />
      <path d="M392 313 L400 318 L392 323" />
    </g>
    <text x="270" y="342" text-anchor="middle" font-size="13" fill="#4A5359" font-family="var(--f-body)">שיפוע לכיוון הניקוז</text>

    <!-- סימוני שכבות -->
    {marks.map(([n, cx, cy, tx, ty]) => (
      <g>
        <line x1={cx} y1={cy < ty ? cy + 13 : cy - 13} x2={tx} y2={ty} stroke="#1B2226" stroke-width=".9" stroke-dasharray="2 3" />
        <circle cx={tx} cy={ty} r="2.6" fill="#1B2226" />
        <circle cx={cx} cy={cy} r="13" fill="#F3F0E9" stroke="#1B2226" stroke-width="1.2" />
        <text x={cx} y={cy + 4.5} text-anchor="middle" font-size="13" font-weight="600" fill="#1B2226" font-family="var(--f-body)">{n}</text>
      </g>
    ))}
  </svg>
  <figcaption>
    <span class="cap">{caption}</span>
    <ol>{legend.map((l) => <li>{l}</li>)}</ol>
  </figcaption>
</figure>
<style>
  .section-fig { margin: 0; }
  .section-fig svg { display: block; width: 100%; height: auto; }
  figcaption { margin-top: 1rem; }
  .cap { display: block; font: 600 .8rem/1.3 var(--f-body); letter-spacing: .06em; color: var(--ink-2); margin-bottom: .6rem; }
  ol { margin: 0; padding: 0; list-style: none; counter-reset: l; display: grid; grid-template-columns: 1fr 1fr; gap: .35rem 1.4rem; font-size: .92rem; line-height: 1.45; color: var(--ink-2); }
  li { counter-increment: l; display: flex; gap: .5rem; }
  li::before { content: counter(l); flex: none; width: 1.35rem; height: 1.35rem; border: 1px solid var(--bitumen); border-radius: 50%; display: grid; place-items: center; font-size: .75rem; font-weight: 600; color: var(--bitumen); margin-top: .05rem; }
  @media (max-width: 520px) { ol { grid-template-columns: 1fr; } }
</style>
