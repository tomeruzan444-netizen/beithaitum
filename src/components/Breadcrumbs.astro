---
interface Props { items: { name: string; url: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="פירורי לחם">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.url}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: .3rem; font-size: .9rem; color: var(--ink-2); }
  .crumbs li:not(:last-child)::after { content: '›'; margin-inline-start: .35rem; color: var(--line); color: var(--ink-2); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--copper-ink); text-decoration: underline; }
</style>
