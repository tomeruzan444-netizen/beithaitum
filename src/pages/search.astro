---
// חיפוש פנימי (Pagefind). ה-JS נטען רק בעמוד הזה, ורק כשהגולש מגיע אליו.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
---
<BaseLayout title="חיפוש באתר | בית האיטום" description="חיפוש במדריכים של בית האיטום: איטום גגות, קירות, מרפסות, חדרים רטובים, רטיבות ונזילות." noindex>
  <div class="wrap srch">
    <Breadcrumbs items={[{ name: 'בית האיטום', url: '/' }, { name: 'חיפוש', url: '/search/' }]} />
    <h1>חיפוש באתר</h1>
    <form action="/search/" method="get" role="search" class="sf">
      <label for="q" class="sr-only">מה לחפש</label>
      <input id="q" name="q" type="search" placeholder="למשל: רטיבות בתקרה, יריעות ביטומניות" autocomplete="off" />
      <button class="btn btn--primary" type="submit">חיפוש</button>
    </form>
    <p id="status" class="st" aria-live="polite"></p>
    <ol id="results" class="res"></ol>
  </div>
</BaseLayout>
<script is:inline>
  (async () => {
    const q = new URLSearchParams(location.search).get('q') || '';
    const input = document.getElementById('q');
    input.value = q;
    if (!q.trim()) return;
    const status = document.getElementById('status');
    status.textContent = 'מחפש...';
    const pf = await import('/pagefind/pagefind.js');
    const r = await pf.search(q);
    const items = await Promise.all(r.results.slice(0, 20).map((x) => x.data()));
    status.textContent = items.length ? `נמצאו ${r.results.length} תוצאות` : 'לא נמצאו תוצאות. נסו ניסוח אחר.';
    const ol = document.getElementById('results');
    for (const it of items) {
      const li = document.createElement('li');
      const a = document.createElement('a');
      a.href = it.url; a.textContent = it.meta.title || it.url;
      const p = document.createElement('p'); p.innerHTML = it.excerpt;
      li.append(a, p); ol.append(li);
    }
  })();
</script>
<style>
  .srch { padding-block: 2rem var(--space); max-width: 820px; }
  .srch h1 { margin-top: 1.2rem; }
  .sf { display: flex; gap: .6rem; margin-block: 1rem; }
  .sf input { flex: 1; min-height: 48px; padding: .6rem 1rem; font: inherit; border: 1.5px solid var(--bitumen); border-radius: var(--r); background: #fff; }
  .st { color: var(--ink-2); }
  .res { list-style: none; padding: 0; }
  .res :global(li) { border-top: 1px solid var(--line); padding-block: 1rem; }
  .res :global(a) { font: 700 1.15rem/1.3 var(--f-head); }
  .res :global(p) { margin: .4rem 0 0; color: var(--ink-2); font-size: 1rem; }
  .res :global(mark) { background: #F0D9CC; color: inherit; }
</style>
