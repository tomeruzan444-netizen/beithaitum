---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroArt from '../components/HeroArt.astro';
import Iso from '../components/Iso.astro';
import type { IsoName } from '../components/Iso.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import { business, isFilled, telHref, waHref } from '../config/business';
import { publishedSet, allPages, urlOf, regionPage, citiesInRegion, type Page } from '../lib/pages';
import { regions, cityBySlug } from '../data/cities';
const pub = await publishedSet();
const allP = await allPages();
const L = (h: string) => (pub.has(h) ? h : null);

const title = 'בית האיטום | חברת איטום לגגות, קירות ומרפסות';
const description =
  'בית האיטום, חברת איטום שמתחילה באבחון מקור המים: איטום גגות, קירות, מרפסות ומרתפים, השוואת שיטות איטום ותשובות לשאלות נפוצות. לקבלת הצעת מחיר.';

const problems = [
  {
    t: 'נזילה מהגג אחרי גשם', href: '/moisture/ceiling-damp/',
    see: 'טפטוף או כתם שמתרחב בתקרה, בעיקר בחורף ובקומה העליונה.',
    cause: 'יריעה שנסדקה או התנתקה, חיבור לא אטום ליד מעקה, ארובה או דוד שמש, נקז סתום שמשאיר מים עומדים על הגג.',
    check: 'מצב שכבת האיטום, נקודות החיבור והמעברים, השיפועים והנקזים.',
  },
  {
    t: 'רטיבות בקיר חיצוני', href: '/moisture/wall-damp/',
    see: 'כתמים, צבע שמתנפח או טיח שמתקלף בצד הפנימי של קיר חוץ.',
    cause: 'סדקים בטיח החיצוני, חדירת מים סביב חלונות ותריסים, קיר שחשוף לגשם שהרוח דוחפת אליו.',
    check: 'סדקים במעטפת, החיבור בין המסגרות לקיר ומצב הציפוי החיצוני.',
  },
  {
    t: 'רטיבות בתחתית הקיר', href: '/moisture/above-skirting/',
    see: 'כתמים ומלחים לבנים בגובה נמוך, פנלים שמתנתקים מהקיר.',
    cause: 'צנרת שדולפת ברצפה, רטיבות שעולה מהקרקע אל הקיר, או מים שעוברים ממקלחת או ממרפסת סמוכה.',
    check: 'את מקור המים לפני הכול. טיפול בקיר בלי לעצור את המקור רק מסתיר את הבעיה.',
  },
  {
    t: 'מרפסת שמדלפת לשכנים', href: '/balconies/',
    see: 'כתמים בתקרה של הדירה שמתחת למרפסת, רובה שמתפוררת בין האריחים.',
    cause: 'שכבת איטום שנפגעה מתחת לריצוף, ניקוז שלא עובד, או חיבור לא אטום בין הרצפה לקיר.',
    check: 'שיפוע הריצוף, מחסום הניקוז, הרובה והאיטום בפינות ובסף הדלת.',
  },
  {
    t: 'רטיבות סביב המקלחת', href: '/interior/shower/',
    see: 'כתם בקיר הצמוד למקלחת או בתקרה של הקומה שמתחת.',
    cause: 'רובה וסיליקון שנשחקו, איטום פגום מתחת לאריחים, או נזילה מהצנרת שבקיר.',
    check: 'האם הרטיבות מופיעה רק אחרי שימוש במקלחת, ומה מצב האיטום מתחת לריצוף.',
  },
  {
    t: 'מרתף או ממ"ד לחים', href: '/structures/basement/',
    see: 'לחות באוויר, ריח של עובש, כתמים על קירות שנמצאים מתחת לפני הקרקע.',
    cause: 'מים מהקרקע שלוחצים על הקירות, איטום חיצוני שלא בוצע או נפגע, סדקים ומעברי צנרת.',
    check: 'מאיפה הלחות מגיעה, האם יש גישה לצד החיצוני של הקיר, והאם נדרש איטום מבפנים.',
  },
];

const methods = [
  ['יריעות ביטומניות', '/methods/bitumen-membranes/', 'יריעות מביטומן משופר שמולחמות לגג בלהבה, בחפיפה בין יריעה ליריעה.', 'גגות בטון שטוחים ושטחים גדולים.', 'צריכות הגנה מקרינת השמש ותשתית יבשה ונקייה בזמן ההלחמה.'],
  ['איטום במריחה (פוליאוריטן)', '/methods/liquid-applied/', 'חומר נוזלי שנמרח בכמה שכבות ומתקשה לממברנה רציפה בלי תפרים.', 'גגות עם הרבה מעברים, מתקנים וחיבורים מורכבים.', 'עובי השכבה וזמני הייבוש לפי הוראות היצרן הם מה שקובע את התוצאה.'],
  ['איטום אקרילי', '/methods/acrylic/', 'ציפוי על בסיס מים, לרוב בגוון לבן שמחזיר קרינה.', 'חידוש ותחזוקה של גג קיים, הפחתת חום בקומה העליונה.', 'פחות מתאים לגג שמים עומדים עליו לאורך זמן.'],
  ['איטום צמנטי וקריסטלי', '/methods/crystalline/', 'חומר על בסיס צמנט, שחלקו חודר לנקבוביות של הבטון.', 'מרתפים, בריכות, מאגרי מים ואיטום מהצד הפנימי של קיר.', 'גמיש פחות, ולכן לא מתאים למשטח עם סדקים שממשיכים לזוז.'],
  ['איטום בהזרקה', '/methods/injection/', 'הזרקת חומר לתוך סדק או מישק כדי לחסום את מעבר המים.', 'סדקים בבטון, מרתפים ונזילות נקודתיות.', 'מטפל בנקודה מסוימת, ולא מחליף מערכת איטום שלמה.'],
];

const faq = [
  ['כמה עולה איטום גג?', 'המחיר נקבע לפי שיטת האיטום, שטח הגג, מצב התשתית והנגישות לגג. גג שצריך רק חידוש של שכבת הציפוי יעלה פחות מגג שבו צריך להסיר יריעות ישנות ולתקן שיפועים. אנחנו נותנים הצעת מחיר אחרי שבדקנו את הגג, כי בלי לראות את התשתית כל מספר הוא ניחוש.'],
  ['מתי הכי כדאי לאטום גג?', 'בעונה היבשה, בדרך כלל מסוף האביב ועד תחילת הסתיו. רוב חומרי האיטום דורשים תשתית יבשה וטמפרטורה בטווח שהיצרן מגדיר, ולכן בחורף אפשר לעבוד רק בחלונות של כמה ימים יבשים ברצף.'],
  ['איך יודעים אם הנזילה מהגג או מהצנרת?', 'נזילה שמופיעה רק אחרי גשם מצביעה בדרך כלל על הגג או על מעטפת הבניין. נזילה שמופיעה גם בימים יבשים, או כשמשתמשים במים בדירה שמעל, מצביעה על צנרת. כשאין תשובה ברורה, עושים איתור נזילות לפני שמפרקים משהו.'],
  ['אפשר לאטום מעל איטום ישן?', 'לפעמים כן. אם השכבה הקיימת צמודה לתשתית, יבשה ומתאימה לחומר החדש, אפשר ליישם מעליה אחרי ניקוי והכנה. אם היא מתקלפת, מנופחת או שכלואים מתחתיה מים, צריך להסיר אותה קודם.'],
  ['מה ההבדל בין יריעות ביטומניות לאיטום במריחה?', 'יריעות הן גלילים שמולחמים לגג ויוצרים שכבה עבה ואחידה. איטום במריחה הוא חומר נוזלי שמתקשה לממברנה רציפה בלי תפרים, ולכן נוח במיוחד בגג עם הרבה מתקנים ומעברים. בפועל, הבחירה תלויה במצב הגג הקיים יותר מאשר בשאלה איזו שיטה טובה יותר.'],
  ['כמה זמן לוקחת עבודת איטום גג?', 'גג של בית פרטי או של בניין קטן נאטם בדרך כלל בכמה ימי עבודה, לפי השיטה, השטח ומצב התשתית. בשיטות מריחה צריך להוסיף את זמני הייבוש בין השכבות שהיצרן מגדיר.'],
  ['צריך לפנות את הגג לפני העבודה?', 'ככל שאפשר, כן. דודי שמש, מעבים של מזגנים ומתקנים אחרים מפריעים ליישום רציף של האיטום, ולפעמים צריך להגביה אותם על רגליות. בבדיקה אנחנו מסמנים מה צריך לפנות ומה אפשר לאטום מסביב.'],
  ['איטום מהצד הפנימי של הקיר באמת עובד?', 'זה נקרא איטום שלילי, והוא פתרון מקובל במרתפים ובחללים שאין גישה לצד החיצוני שלהם. הוא מונע מהמים להיכנס לחלל, אבל הקיר עצמו נשאר רטוב. כשיש גישה מבחוץ, עדיף בדרך כלל לאטום מהצד החיצוני.'],
];

const siteUrl = new URL('/', Astro.site).href;
const schema = [
  {
    '@type': 'RoofingContractor',
    '@id': `${siteUrl}#business`,
    name: business.name,
    url: siteUrl,
    parentOrganization: { '@id': `${siteUrl}#org` },
    ...(isFilled(business.phone) && { telephone: business.phone }),
    ...(isFilled(business.email) && { email: business.email }),
  },
  {
    '@type': 'FAQPage',
    mainEntity: faq.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })),
  },
];
const steps = [
  ['שיחה ותמונות', 'מספרים לנו מה רואים, איפה ומתי. תמונה של הכתם או של הגג מקצרת את הדרך.'],
  ['אבחון בשטח', 'עולים לגג ובודקים שכבות, סדקים, ניקוז ומקורות נזילה.'],
  ['הצעה שקופה', 'שיטה, חומרים, שטח ושלבי עבודה כתובים בהצעה, כל סעיף בנפרד.'],
  ['ביצוע ובדיקה', 'עבודה לפי הוראות היצרן, ובגג שטוח בדיקת הצפה לפני המסירה כשאפשר.'],
];
const roofPick = [
  ['בטון שטוח', '/roof-waterproofing/flat-roof/'],
  ['רעפים', '/roof-waterproofing/tiled-roof/'],
  ['איסכורית או פנל', '/roof-waterproofing/corrugated-roof/'],
  ['מרפסת או גג מרוצף', '/roof-waterproofing/paved-roof/'],
].filter(([, h]) => pub.has(h));
const layerCards: [string, string, string, IsoName][] = [
  ['/roof-waterproofing/concrete-roof/', 'איטום גג בטון', 'גגות שטוחים בבתים ובבניינים: יריעות, פוליאוריטן או ממברנה.', 'concrete'],
  ['/methods/bitumen-membranes/', 'יריעות ביטומניות', 'יריעות מולחמות שיוצרות שכבה עבה ועמידה לגג ותיק.', 'membrane'],
  ['/methods/polyurethane/', 'איטום בפוליאוריטן', 'ציפוי נוזלי רציף בלי תפרים, לגגות עמוסים בדודים ומתקנים.', 'liquid'],
  ['/roof-waterproofing/tiled-roof/', 'גגות רעפים', 'החלפת רעפים שבורים, איטום רכסים ויריעה תת-רעפית.', 'tiles'],
  ['/roof-waterproofing/corrugated-roof/', 'איסכורית ופנלים', 'ברגים, חפיפות וחלודה בגגות פח, מחסנים ומבנים קלים.', 'metal'],
  ['/balconies/', 'מרפסות וגגות מרוצפים', 'איטום מתחת לריצוף, או ציפוי שקוף מעל הריצוף הקיים.', 'terrace'],
].filter(([h]) => pub.has(h)) as [string, string, string, IsoName][];
const guides = ['/moisture/ceiling-damp/', '/methods/liquid-applied/', '/roof-waterproofing/renewal/', '/prices/']
  .map((u) => allP.find((p) => urlOf(p) === u)).filter(Boolean) as Page[];
const areaCols = await Promise.all(regions.map(async (r) => ({ r, page: await regionPage(r.slug), cities: await citiesInRegion(r.slug) })));
const jlm = allP.filter((p) => p.data.type === 'city' && !cityBySlug(p.data.city ?? '')?.region);
---
<BaseLayout title={title} description={description} schema={schema} cta={['התחיל לטפטף?', 'דברו איתנו.']}>

  <section class="hero">
    <div class="wrap hero-in">
      <div class="ht">
        <p class="kicker"><span class="bars"><i></i><i></i><i></i></span> חברת איטום · שכבה אחרי שכבה</p>
        <h1><span class="h1b">בית האיטום</span> בין הגשם לבין הסלון שלכם יש <span class="c">ארבע שכבות.</span></h1>
        <p class="lead">כשאחת מהן נסדקת, מתנתקת או נשחקת, המים מוצאים דרך. אנחנו בודקים את כולן, מאתרים את המקור ומתקנים רק את מה שצריך, כדי שהגג יעבוד שוב כמערכת אחת.</p>
        <div class="cta-row">
          <a class="btn btn--primary" href="#roof-check">בדקו את הגג שלכם ↓</a>
          <a class="call" href={telHref()}>או התקשרו: {isFilled(business.phone) ? <span dir="ltr">{business.phone}</span> : '[מספר טלפון]'}</a>
        </div>
      </div>
      <div class="ha"><HeroArt variant="layers" title="ארבע השכבות שבין הגשם לבין הבית" /></div>
    </div>
  </section>

  <section id="roof-check" class="sec check">
    <div class="wrap check-in">
      <div>
        <p class="kicker"><span class="bars"><i></i><i></i><i></i></span> שכבה 1 · שכבת הגמר</p>
        <h2>מה מצב הגג שלכם?</h2>
        <p class="sub">בחרו את סוג הגג, ותגיעו ישר למדריך שמסביר מה בודקים, אילו שיטות מתאימות וכמה זה עולה.</p>
        <ol class="points">
          <li><b>01</b>אבחון בשטח לפני כל הצעת מחיר</li>
          <li><b>02</b>הצעה מפורטת לפי שכבות וחומרים</li>
          <li><b>03</b>עבודה לפי הוראות היצרן ובדיקה בסוף</li>
        </ol>
      </div>
      {roofPick.length > 0 && (
        <div class="pick">
          <p class="pk">בדיקת גג ב-30 שניות</p>
          <p class="pq">איזה גג יש לכם?</p>
          <ul>{roofPick.map(([t, h]) => <li><a href={h}><span>{t}</span><i aria-hidden="true">←</i></a></li>)}</ul>
        </div>
      )}
    </div>
  </section>

  {layerCards.length > 0 && (
    <section class="sec dark">
      <div class="wrap">
        <div class="dh">
          <div>
            <p class="kicker"><span class="bars"><i></i><i></i><i></i></span> שכבה 2 · יריעת האיטום</p>
            <h2>לכל גג, שכבה משלו</h2>
          </div>
          <p>כל סוג גג נכשל בדרך אחרת, ולכן גם מטופל אחרת. כך אנחנו בוחרים שיטת עבודה, חומרים ובדיקה.</p>
        </div>
        <ul class="lcards">
          {layerCards.map(([h, t, s, ic]) => (
            <li><a href={h}><Iso name={ic} size={64} /><span class="lk">{t}</span><span class="ls">{s}</span></a></li>
          ))}
        </ul>
        {L('/moisture/leak-detection/') && <a class="more" href="/moisture/leak-detection/">גם איתור נזילות וקירות חיצוניים ←</a>}
      </div>
    </section>
  )}

  <section id="process" class="sec copper">
    <div class="wrap">
      <p class="kicker"><span class="bars"><i></i><i></i><i></i></span> שכבה 3 · הפריימר, מה שמחבר הכול</p>
      <h2>ארבעה צעדים, בלי הפתעות</h2>
      <ol class="steps">
        {steps.map(([t, d], i) => <li><span class="sn">{i + 1}</span><h3>{t}</h3><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <section id="problems" class="sec">
    <div class="wrap">
      <div class="sh">
        <p class="kicker"><span class="bars"><i></i><i></i><i></i></span> שכבה 4 · הבטון והשיפועים</p>
        <h2>מה הבעיה שלכם?</h2>
        <p class="sub">רוב הפניות מתחילות בסימן אחד שרואים בבית. כך נראים הסימנים הנפוצים, מה עומד מאחוריהם בדרך כלל, ומה אנחנו בודקים כדי להגיע למקור.</p>
      </div>
      <ol class="problems">
        {problems.map((p, i) => (
          <li>
            <span class="pn">{String(i + 1).padStart(2, '0')}</span>
            <h3>{L(p.href) ? <a href={p.href}>{p.t}</a> : p.t}</h3>
            <dl>
              <div><dt>מה רואים</dt><dd>{p.see}</dd></div>
              <div><dt>מקורות נפוצים</dt><dd>{p.cause}</dd></div>
              <div><dt>מה אנחנו בודקים</dt><dd>{p.check}</dd></div>
            </dl>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section id="methods" class="sec mist">
    <div class="wrap">
      <div class="sh">
        <h2>שיטות האיטום, זו מול זו</h2>
        <p class="sub">אין שיטת איטום אחת שמתאימה לכל מקום. זו ההשוואה שכדאי להכיר לפני שבוחרים פתרון{L('/methods/') && <>, והפירוט המלא נמצא במדריך <a href="/methods/">שיטות איטום</a></>}.</p>
      </div>
      <div class="spec-scroll">
        <table class="spec">
          <thead><tr><th scope="col">שיטה</th><th scope="col">איך זה עובד</th><th scope="col">מתאים במיוחד ל</th><th scope="col">שימו לב</th></tr></thead>
          <tbody>
            {methods.map(([a, h, b, c, d]) => <tr><th scope="row">{L(h) ? <a href={h}>{a}</a> : a}</th><td>{b}</td><td>{c}</td><td>{d}</td></tr>)}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section id="areas" class="sec areas">
    <div class="wrap">
      <div class="ah">
        <h2>איפה אנחנו עובדים</h2>
        {L('/areas/') && <a class="more" href="/areas/">לכל אזורי השירות ←</a>}
      </div>
      <div class="acols">
        {areaCols.filter((a) => a.cities.length).map((a) => (
          <div>
            <p class="ar">{a.page ? <a href={urlOf(a.page)}>{a.r.name}</a> : a.r.name}</p>
            <ul>{a.cities.map((c) => <li><a href={urlOf(c)}>{c.data.keyword.replace(/^איטום גגות ב/, '')}</a></li>)}</ul>
          </div>
        ))}
        {jlm.length > 0 && <div><p class="ar">ירושלים</p><ul>{jlm.map((c) => <li><a href={urlOf(c)}>{c.data.keyword.replace(/^איטום גגות ב/, '')}</a></li>)}</ul></div>}
      </div>
    </div>
  </section>

  <section id="faq" class="sec sand">
    <div class="wrap faq-wrap">
      <div>
        <h2>שאלות ששואלים אותנו</h2>
        {guides.length > 0 && (
          <div class="gbox">
            <p class="gk">לפני שמחליטים</p>
            <ul>{guides.map((g) => <li><a href={urlOf(g)}>{g.data.keyword}</a></li>)}</ul>
          </div>
        )}
      </div>
      <div class="faq">
        {faq.map(([q, a]) => <details><summary>{q}</summary><div><p>{a}</p></div></details>)}
      </div>
    </div>
  </section>

  <section id="contact" class="sec contact">
    <div class="wrap contact-in">
      <div>
        <h2>בואו נבדוק מה קורה אצלכם</h2>
        <p class="sub">ספרו לנו מה אתם רואים, איפה ומתי זה מופיע. תמונה של הכתם או של הגג בוואטסאפ עוזרת לנו להבין מה לבדוק עוד לפני שמגיעים.</p>
        <div class="cbtns">
          <a class="btn btn--primary" href={telHref()}><Icon name="phone" /><span dir="ltr">{business.phone}</span></a>
          <a class="btn" href={waHref()}><Icon name="chat" />שליחת תמונה בוואטסאפ</a>
        </div>
      </div>
      <LeadForm title="השאירו פרטים ונחזור אליכם" />
    </div>
  </section>
</BaseLayout>

